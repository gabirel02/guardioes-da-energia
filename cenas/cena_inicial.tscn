[node name="Texto" type="Label" parent="CamadaAjuda/PainelAjuda/SecaoSolar"]
layout_mode = 0
offset_left = 18.0
offset_top = 124.0
offset_right = 342.0
offset_bottom = 515.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_constants/line_spacing = 2
theme_override_font_sizes/font_size = 21
text = "1. Passe o mouse nas manchas para limpar os painéis solares.
2. Clique em GIRAR ou use as setas do teclado para virar o painel em direção ao sol.
3. Quando estiver na posição certa, clique em CONFIRMAR ou aperte ENTER."
autowrap_mode = 3

