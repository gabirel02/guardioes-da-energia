theme_override_font_sizes/font_size = 23
text = "Olá, Guardião! Precisamos da sua ajuda!
Nossa cidade está sem energia! Ajude o Tiko a ligar as três usinas e trazer a luz de volta!
Clique em VAMOS JOGAR para participar da aventura completa.
Ou escolha uma usina para jogar somente aquela fase."
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 3

