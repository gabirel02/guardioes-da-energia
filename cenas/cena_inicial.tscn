offset_bottom = 515.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_constants/line_spacing = 2
theme_override_font_sizes/font_size = 21
text = "1. Observe a barra azul, que mostra a quantidade de água.
2. Mantenha a água na faixa verde IDEAL durante 1 minuto.
3. Se a água subir demais, clique em ABRIR COMPORTA ou aperte A.
4. Se a água baixar demais, clique em FECHAR COMPORTA ou aperte F."
autowrap_mode = 3

