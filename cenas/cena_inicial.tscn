[node name="Texto" type="Label" parent="CamadaAjuda/PainelAjuda/SecaoEolica"]
layout_mode = 0
offset_left = 18.0
offset_top = 124.0
offset_right = 342.0
offset_bottom = 515.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_constants/line_spacing = 2
theme_override_font_sizes/font_size = 21
text = "1. Fique atento ao aviso VEM VENTO FORTE!
2. Quando o vento ficar forte, segure o botão FREIO ou a tecla ESPAÇO para proteger a turbina.
3. Quando o vento ficar fraco, solte o freio para produzir energia."
autowrap_mode = 3

